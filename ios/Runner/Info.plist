<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Tepovka</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>tepovka</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIRequiresFullScreen</key>
		<true/>
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
		</array>
		<key>NSCameraUsageDescription</key>
		<string>Tato aplikace potřebuje přístup k fotoaparátu pro měření vaší srdeční frekvence.</string>
		<key>NSHealthShareUsageDescription</key>
		<string>Aplikace potřebuje přístup k HealthKit pro čtení dat tepové frekvence.</string>
		<key>NSHealthUpdateUsageDescription</key>
		<string>Aplikace potřebuje přístup k HealthKit pro ukládání tepové frekvence.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Tato aplikace potřebuje přístup k mikrofonu pro použití blesku při měření.</string>
		<key>NSMotionUsageDescription</key>
		<string>Tato aplikace potřebuje přístup k pohybovým senzorům pro potlačení pohybových artefaktů během měření.</string>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Tepovka implements no encryption of its own: no crypto APIs are
	     called from Dart or from the iOS target, and the app makes no
	     network requests (external links are handed to Safari). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- iOS filters NSLocale.preferredLanguages against this list, and
	     Flutter reads its locale from there. Without it the app is only
	     ever offered its development region, so the Czech UI would not
	     be selected on a Czech device. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>cs</string>
		<string>en</string>
	</array>
</dict>
</plist>
