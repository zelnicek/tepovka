<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Tepovka</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>tepovka</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIRequiresFullScreen</key>
		<true/>
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
		</array>
		<key>NSCameraUsageDescription</key>
		<string>Tepovka měří tep kamerou a bleskem: přiložený prst mění barvu obrazu s každým úderem srdce. Snímky se nikam neukládají ani neodesílají.</string>
		<key>NSHealthShareUsageDescription</key>
		<string>Tepovka pracuje s tepovou frekvencí v aplikaci Zdraví. Data ze Zdraví nikam neodesílá.</string>
		<key>NSHealthUpdateUsageDescription</key>
		<string>Po měření Tepovka uloží do aplikace Zdraví tepovou frekvenci a u měření od 60 sekund s dobrým signálem i variabilitu srdečního rytmu (HRV).</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Tepovka mikrofon nepoužívá a o přístup k němu nežádá. Systém tento popis vyžaduje kvůli knihovně fotoaparátu.</string>
		<key>NSMotionUsageDescription</key>
		<string>Tepovka sleduje pohyb telefonu, aby poznala, kdy se během měření hýbete a výsledek by byl nepřesný.</string>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Tepovka implements no encryption of its own: no crypto APIs are
	     called from Dart or from the iOS target, and the app makes no
	     network requests (external links are handed to Safari). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- iOS filters NSLocale.preferredLanguages against this list, and
	     Flutter reads its locale from there. Without it the app is only
	     ever offered its development region, so the Czech UI would not
	     be selected on a Czech device. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>cs</string>
		<string>en</string>
	</array>
	<!-- Required to launch on iOS 27 when built with the iOS 27 SDK. Mirrors
	     Flutter's own app template, except the delegate is FlutterSceneDelegate
	     itself: the template's SceneDelegate subclass is empty, and using the
	     framework class directly avoids adding a source file to the project. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cz.mojetepovka.tepovka</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tepovka</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
